# This file is documentation; the server reads process environment variables directly.
# Production defaults: direct WSS on 0.0.0.0:443.
LOBBY_DEV_MODE=0
LOBBY_HOST=0.0.0.0
LOBBY_PORT=443
LOBBY_TLS_CERT_FILE=/usr/local/etc/ssl/game.bitfire.co/fullchain.pem
LOBBY_TLS_KEY_FILE=/usr/local/etc/ssl/game.bitfire.co/privkey.pem
# LOBBY_TLS_KEY_PASSPHRASE=
LOBBY_DATABASE_PATH=/var/db/checkerboard-chase/lobby.sqlite3
# Required. Generate once with: openssl rand -base64 48
LOBBY_TOKEN_PEPPER=

LOBBY_REGISTRATION_TIMEOUT=10
LOBBY_RESERVATION_SECONDS=172800
LOBBY_HISTORY_COUNT=20
LOBBY_MAX_FRAME_BYTES=16384
LOBBY_MAX_CHAT_CHARACTERS=500
LOBBY_PING_INTERVAL=30
LOBBY_PONG_TIMEOUT=75
LOBBY_REGISTER_RATE_COUNT=5
LOBBY_REGISTER_RATE_WINDOW=60
LOBBY_CHAT_RATE_COUNT=12
LOBBY_CHAT_RATE_WINDOW=10
LOBBY_CLEANUP_INTERVAL=300
LOBBY_LOG_LEVEL=info
